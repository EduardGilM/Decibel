{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decibel",
  "version": "0.1.20",
  "identifier": "app.decibel.music",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Decibel",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "backgroundColor": "#0b0b0b",
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons-symmetric/32x32.png",
      "icons-symmetric/128x128.png",
      "icons-symmetric/128x128@2x.png",
      "icons-symmetric/icon.icns",
      "icons-symmetric/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Self-hosted music player",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
