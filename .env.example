# Copy this file to .env.local and adjust it. Never commit .env.local.
# NEXT_PUBLIC_* variables are baked in at build time (npm run build); the rest are read by the server at start-up.

# ---- Web / app (build time) ----
# Initial source: ytdlp = YouTube Music (default) | mock = demo | subsonic = Navidrome
NEXT_PUBLIC_DATA_SOURCE=ytdlp
# Music service URL. Empty = the same server that serves the web app (in development, port 3001).
# For the native app (Tauri/APK) or a web app hosted elsewhere, set the public URL of your Decibel server.
NEXT_PUBLIC_YTDLP_URL=
# Fixed profile server. Empty = the app asks for the source/server on /login.
# When set, the app always uses that server and does not offer to switch source (useful for your own APK).
# Example: NEXT_PUBLIC_DECIBEL_SERVER=https://decibel.example.com
NEXT_PUBLIC_DECIBEL_SERVER=
# URL pre-filled in the Navidrome/Subsonic login (optional)
# NEXT_PUBLIC_SUBSONIC_URL=http://navidrome.example.lan:4533

# ---- Server ----
MUSIC_PORT=3000
# Listen address. Behind a proxy or tunnel on the same machine, use 127.0.0.1.
# MUSIC_HOST=127.0.0.1
MUSIC_DATA_DIR=data/music
# SQLite database for profiles (default data/decibel.db)
# DECIBEL_DB=data/decibel.db
# First start (empty database): initial administrator. Without a password a random one is generated and
# printed once in the log. Ignored once users exist.
# DECIBEL_ADMIN_USER=admin
# DECIBEL_ADMIN_PASSWORD=
# Trusted proxy for X-Forwarded-Proto and CF-Connecting-IP: false (default), loopback (tunnel or proxy
# on the same machine, e.g. cloudflared) or a list of proxy IPs. Required when HTTPS is terminated at the proxy,
# so the cookie is Secure, CORS accepts the site's own https:// origin and login rate limiting sees real IPs.
# DECIBEL_TRUST_PROXY=loopback
# Additional allowed CORS origins, comma-separated: external web app or native app.
YTDLP_ALLOWED_ORIGINS=http://tauri.localhost,tauri://localhost,https://tauri.localhost
# Optional: externally installed yt-dlp executable. Defaults to .tools/yt-dlp.
# YTDLP_BIN=/usr/local/bin/yt-dlp
# Writable cache when the application is installed in a read-only directory.
# YTDLP_CACHE_DIR=/var/lib/decibel/cache/yt-dlp
# Optional: Python with ytmusicapi installed. Defaults to .tools/ytmusic.
# YTMUSIC_PYTHON=/path/to/venv/bin/python
# Only for music:setup: Python 3.10+ used to create the local environment.
# PYTHON_BIN=/usr/bin/python3
