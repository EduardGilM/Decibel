[Unit]
Description=Decibel (web app, profiles and YouTube Music)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=decibel
Group=decibel
WorkingDirectory=/opt/decibel
Environment=NODE_ENV=production
Environment=DECIBEL_TRUST_PROXY=loopback
Environment=MUSIC_HOST=127.0.0.1
Environment=MUSIC_PORT=3000
Environment=DECIBEL_DB=/var/lib/decibel/decibel.db
Environment=MUSIC_DATA_DIR=/var/lib/decibel/music
Environment=HOME=/var/lib/decibel
Environment=XDG_CACHE_HOME=/var/lib/decibel/cache
Environment=PYTHONDONTWRITEBYTECODE=1
# Runtime tools live in a root-owned tree the service can run but not modify.
Environment=YTDLP_BIN=/opt/decibel-runtime/ytmusic/bin/yt-dlp
Environment=YTMUSIC_PYTHON=/opt/decibel-runtime/ytmusic/bin/python
Environment=YTDLP_CACHE_DIR=/var/lib/decibel/cache/yt-dlp
# Optional: a bgutil PO token provider on localhost and the root-owned folder its yt-dlp plugin is loaded
# from (see docs/pot-provider.md). Without YTDLP_POT_URL yt-dlp plugins stay disabled.
#Environment=YTDLP_POT_URL=http://127.0.0.1:4416
#Environment=YTDLP_PLUGIN_DIRS=/opt/decibel-runtime/ytmusic/lib/python3.13
# Public downloads and update manifests (/download, /releases/*, /api/app/version); root-owned, read-only here.
Environment=DECIBEL_RELEASES_DIR=/srv/decibel-releases
Environment=YTDLP_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
ExecStart=/usr/local/bin/node /opt/decibel/server/index.mjs
Restart=always
RestartSec=3
StateDirectory=decibel
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/decibel
ReadOnlyPaths=/opt/decibel-runtime /opt/decibel /srv/decibel-releases

[Install]
WantedBy=multi-user.target
