{
  "name": "decibel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "npm run serve",
    "lint": "eslint",
    "serve": "node --env-file-if-exists=.env.local server/index.mjs",
    "publish": "node --env-file-if-exists=.env.local scripts/publish.mjs",
    "package:server": "node scripts/package-server.mjs",
    "music:setup": "node --env-file-if-exists=.env.local scripts/setup-music.mjs",
    "music:server": "node --env-file-if-exists=.env.local server/index.mjs --api-only",
    "test": "node --experimental-strip-types --test server/*.test.mjs tests/*.test.mjs",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "serve-handler": "^6.1.7",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "spark-md5": "^3.0.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/spark-md5": "^3.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
