# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.tools/
/data/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.screenshots/
screenshots-private/

# datos, copias y logs (nunca en el repo)
*.db
*.db-*
*.sqlite
*.sqlite3
backups/
*.log
*.tgz

# firma y credenciales
*.jks
*.keystore
keystore.properties
key.properties
google-services.json
GoogleService-Info.plist
cookies*.txt
*.cookies
credentials*.json
*.p12
*.key

# binarios de la app
*.apk
*.aab
*.ipa

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri
/src-tauri/target/
/src-tauri/gen/
!.env.example
